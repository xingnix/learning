[2.256474, "o", "\b\b\b\u001b[24mg\u001b[24mr\u001b[24ma\u001b[39md\u001b[39mi\u001b[39me\u001b[39mn\u001b[39mt\u001b[39m_\u001b[39md\u001b[39me\u001b[39ms\u001b[39mc\u001b[39me\u001b[39mn\u001b[39mt\u001b[39m_\u001b[39mz\u001b[39my\u001b[39mg\u001b[39mo\u001b[39mt\u001b[39me\u001b[39m_\u001b[39md\u001b[39me\u001b[39mm\u001b[39mo\u001b[K\u001b[10C\u001b[0m\u001b[49m\u001b[30m\u001b[0m\u001b[30m\u001b[40m\u001b[32m \u001b[0m\u001b[32m\u001b[40m\u001b[40m\u001b[32m✔\u001b[0m\u001b[32m\u001b[40m\u001b[40m\u001b[32m \u001b[0m\u001b[32m\u001b[40m\u001b[40m\u001b[32m\u001b[0m\u001b[32m\u001b[40m\u001b[40m\u001b[33m xing@x-desktop\u001b[0m\u001b[33m\u001b[40m\u001b[40m\u001b[33m\u001b[0m\u001b[33m\u001b[40m\u001b[40m\u001b[33m \u001b[0m\u001b[33m\u001b[40m\u001b[49m\u001b[39m\u001b[31D"]
[2.261627, "o", "\u001b[28D\u001b[4mg\u001b[4mr\u001b[4ma\u001b[4md\u001b[4mi\u001b[4me\u001b[4mn\u001b[4mt\u001b[4m_\u001b[4md\u001b[4me\u001b[4ms\u001b[4mc\u001b[4me\u001b[4mn\u001b[4mt\u001b[4m_\u001b[4mz\u001b[4my\u001b[4mg\u001b[4mo\u001b[4mt\u001b[4me\u001b[4m_\u001b[4md\u001b[4me\u001b[4mm\u001b[4mo\u001b[24m"]
