[5.21532, "o", "\u001b]2;cat gradient_descent_zygote_demo.jl\u0007\u001b]1;\u0007"]
[5.217564, "o", "using Zygote\r\n\r\n# simple example\r\nfunction simple_example()\r\n    f= (p)->\r\n         (x)->p*x \r\n    p=randn() \r\n    for i in 1:50\r\n         x=randn()\r\n         g=gradient((p)->(f(p)(x).-x)^2,p)[1]\r\n         p=p-0.1.*g\r\n         println(p)\r\n    end\r\n    print(p)\r\nend\r\n\r\n\r\n# nonlinear example\r\nfunction nonlinear()\r\n    f(p,x)= p[1]*x[1]/(1+p[2]*x[2]^2)\r\n    l(p,x,t)=sum((f(p,x)-t).^2)\r\n    p=randn(2).+1.5\r\n    for i in 1:50\r\n         x=randn(2)\r\n         t=x[1]/(1+2*x[2]^2)\r\n         g=gradient((p)->l(p,x,t),p)[1]\r\n         p=p .-0.10.*g\r\n         println(p)\r\n    end\r\n    print(p)\r\nend\r\n\r\nfunction main(args)\r\n    if isempty(args)\r\n       println(\"usage: julia gradient_descent_zygote_demo.jl  <args>\\n <args>:  simple or nonlinear\\n\")\r\n    elseif args[1]==\"simple\"\r\n        simple_example()\r\n    elseif args[1]==\"nonlinear\"\r\n        nonlinear()\r\n    else\r\n       println(\"usage: julia gradient_descent_zygote_demo.jl  <args>\\n <args>:  simple or nonlinear\\n\")\r\n    end\r\nend\r\nmain(ARGS)\r\n"]
