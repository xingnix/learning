[4.390101, "o", "\u001b[A\u001b[83C\u001b[32mc\u001b[32ma\u001b[32mt\u001b[32m \u001b[32mg\u001b[32mr\u001b[32ma\u001b[32md\u001b[32mi\u001b[32me\u001b[32mn\u001b[32mt\u001b[32m_\u001b[32md\u001b[32me\u001b[32ms\u001b[32mc\u001b[32me\u001b[32mn\u001b[32mt\u001b[32m_\u001b[32mz\u001b[32my\u001b[39mg\u001b[20P\u001b[12C\u001b[K\u001b[6C\u001b[0m\u001b[49m\u001b[30m\u001b[0m\u001b[30m\u001b[40m\u001b[32m \u001b[0m\u001b[32m\u001b[40m\u001b[40m\u001b[32m✔\u001b[0m\u001b[32m\u001b[40m\u001b[40m\u001b[32m \u001b[0m\u001b[32m\u001b[40m\u001b[40m\u001b[32m\u001b[0m\u001b[32m\u001b[40m\u001b[40m\u001b[33m xing@x-desktop\u001b[0m\u001b[33m\u001b[40m\u001b[40m\u001b[33m\u001b[0m\u001b[33m\u001b[40m\u001b[40m\u001b[33m \u001b[0m\u001b[33m\u001b[40m\u001b[49m\u001b[39m\u001b[1B\r\u001b[K\u001b[A\u001b[119C"]
[4.393602, "o", "\u001b[33D\u001b[32mt\u001b[39m\u001b[39m \u001b[39m\u001b[4mg\u001b[39m\u001b[4mr\u001b[39m\u001b[4ma\u001b[39m\u001b[4md\u001b[39m\u001b[4mi\u001b[39m\u001b[4me\u001b[39m\u001b[4mn\u001b[39m\u001b[4mt\u001b[39m\u001b[4m_\u001b[39m\u001b[4md\u001b[39m\u001b[4me\u001b[39m\u001b[4ms\u001b[39m\u001b[4mc\u001b[39m\u001b[4me\u001b[39m\u001b[4mn\u001b[39m\u001b[4mt\u001b[39m\u001b[4m_\u001b[39m\u001b[4mz\u001b[39m\u001b[4my\u001b[4mg\u001b[11C"]
