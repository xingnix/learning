[3.583678, "o", "import jax\r\nx=jax.numpy.array([[1,2],[3,4]])\r\nj=jax.jacobian(jax.grad(lambda y:jax.numpy.sum(y*jax.numpy.inner(x,y))))(jax.numpy.array([3.0,2]))\r\nprint(j)\r\n"]
