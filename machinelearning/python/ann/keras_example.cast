[4.655629, "o", "\b\b\b\b\u001b[24mk\u001b[24me\u001b[24mr\u001b[24ma\u001b[39ms\u001b[39m_\u001b[39me\u001b[39mx\u001b[39ma\u001b[39mm\u001b[39mp\u001b[39ml\u001b[39me\u001b[39m."]
[4.660269, "o", "\u001b[14D\u001b[4mk\u001b[4me\u001b[4mr\u001b[4ma\u001b[4ms\u001b[4m_\u001b[4me\u001b[4mx\u001b[4ma\u001b[4mm\u001b[4mp\u001b[4ml\u001b[4me\u001b[4m.\u001b[24m"]
[5.352015, "o", "\u001b[39mp\u001b[39my"]
